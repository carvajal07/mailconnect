        </mxCell>
        <mxCell id="sfn" parent="1" vertex="1" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;&lt;b&gt;Distributed Map&lt;/b&gt;&lt;br&gt;ItemBatcher = 50&lt;br&gt;child = Express" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;">
          <mxGeometry x="792" y="378" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambda-worker" parent="1" vertex="1" value="&lt;b&gt;Lambda Render&lt;/b&gt;&lt;br&gt;&lt;b&gt;Worker&lt;/b&gt; (lote)&lt;br&gt;misma imagen&lt;br&gt;que la síncrona" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;">
          <mxGeometry x="918" y="378" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note-async" parent="1" vertex="1" value="&lt;b&gt;ItemBatcher = 50 documentos por invocación&lt;/b&gt; (~9,5 s cada una).&lt;br&gt;⚠️ No es por el arranque en frío —son solo 200 ms medidos— sino por la&lt;br&gt;&lt;b&gt;orquestación&lt;/b&gt;: SQS $36→$0,72 · SFN $30→$0,60 · DynamoDB $112→$0,01 al mes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Concurrencia:&lt;/b&gt; 310 drena 1M en 10 min · 103 → 30 min · 52 → 1 h&lt;br&gt;(límite de cuenta 1.000; se reservan ~20 para el carril síncrono).&lt;br&gt;&lt;br&gt;&lt;b&gt;Idempotencia:&lt;/b&gt; claim condicional por (jobId, docId) + key S3 determinista&lt;br&gt;→ un reintento sobrescribe, no duplica. Mismo patrón que _claim_part." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=4;">
          <mxGeometry x="1010" y="368" width="536" height="132" as="geometry" />
        </mxCell>

        <mxCell id="dlq" parent="1" vertex="1" value="&lt;b&gt;SQS DLQ&lt;/b&gt;&lt;br&gt;fallos por ítem&lt;br&gt;+ replay" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;">
