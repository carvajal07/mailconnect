        <mxCell id="lbl-sync" parent="1" vertex="1" value="CARRIL SÍNCRONO — interactivo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#15803d;">
